<!--
  forge-bespoke / clinic / reviews.html.tmpl

  Industry: Clinic & Medical
  Honest aggregate. No fabricated quotes. GBP count + score + deep-link.
-->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Reviews - {{business_name}}</title>
  <meta name="description" content="{{meta_description}}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="canonical" href="{{canonical_url}}/reviews.html">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="theme-light" data-hours='{{hours_json}}' data-whatsapp="{{whatsapp_intl}}" data-phone="{{phone_intl}}">

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <img src="/assets/logo.svg" alt="{{business_name}}" width="120" height="32">
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/">Home</a>
      <a href="/services.html">Services</a>
      <a href="/reviews.html" aria-current="page">Reviews</a>
      <a href="/contact.html">Contact</a>
      <a href="/about.html">About</a>
    </nav>
    <a class="btn btn--primary site-header__cta" href="{{whatsapp_url}}">WhatsApp to Enquire</a>
  </div>
</header>

<main id="main">

  <section class="page-hero">
    <div class="page-hero__inner">
      <h1 class="page-hero__heading">{{review_count}} Google reviews. {{rating_score}} average.</h1>
      <p class="page-hero__subtext">No quotes invented. Read every review on Google, or leave one yourself.</p>
    </div>
  </section>

  <section class="reviews-summary">
    <div class="reviews-summary__inner">
      <div class="reviews-summary__stats">
        <div class="reviews-summary__cell">
          <span class="reviews-summary__num">{{rating_score}}</span>
          <span class="reviews-summary__label">average score</span>
        </div>
        <div class="reviews-summary__cell">
          <span class="reviews-summary__num">{{review_count}}</span>
          <span class="reviews-summary__label">reviews on Google</span>
        </div>
        <div class="reviews-summary__cell">
          <span class="reviews-summary__num">{{rating_distribution_5}}%</span>
          <span class="reviews-summary__label">5-star reviews</span>
        </div>
      </div>
      <div class="reviews-summary__ctas">
        <a class="btn btn--primary" href="{{google_reviews_url}}" target="_blank" rel="noopener">Read all reviews on Google</a>
        <a class="btn btn--ghost" href="{{leave_review_url}}" target="_blank" rel="noopener">Leave a review</a>
      </div>
    </div>
  </section>

  <section class="reviews-explain">
    <div class="reviews-explain__inner">
      <h2 class="section-heading">Why we don't show quotes on this page.</h2>
      <p>We could copy the best reviews onto this page. We don't, because:</p>
      <ol>
        <li>Reviews belong to Google. We don't own them, and copying them here without permission is a misrepresentation.</li>
        <li>The score and count on this page are exactly what Google says. We refresh them monthly.</li>
        <li>If you've been here, you can leave a review below. If you haven't, the best way to read reviews is on Google.</li>
      </ol>
    </div>
  </section>

</main>

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <p class="site-footer__brand">{{business_name}}</p>
    <p class="site-footer__address">{{address_full}}</p>
    <p class="site-footer__contact">
      <a href="{{whatsapp_url}}">WhatsApp</a> ·
      <a href="tel:{{phone_raw}}">{{phone_display}}</a> ·
      <a href="mailto:{{email}}">{{email}}</a>
    </p>
    <p class="site-footer__legal">© {{year}} {{business_name}}. Made with care by <a href="https://forge.bruuhh.com" target="_blank" rel="noopener">Forge</a>.</p>
  </div>
</footer>

<div class="mobile-cta" role="navigation" aria-label="Quick actions">
  <div class="mobile-cta__inner">
    <a class="btn btn--whatsapp" href="{{whatsapp_url}}" target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn btn--secondary" href="tel:{{phone_raw}}">Call</a>
  </div>
</div>

<script src="/open-now.js" defer></script>
</body>
</html>